///|
/// Look up the bitmap-table index for character `ch`. Out-of-range
/// chars (anything outside 0x20..0x7E, including < 0x20 control chars
/// and >= 0x7F non-ASCII) fall back to the tofu glyph index (`95`)
/// so callers never index OOB.
pub fn glyph_index(ch : Int) -> Int {
  if ch >= 0x20 && ch <= 0x7E {
    ch - 0x20
  } else {
    // Tofu is the last glyph in the table.
    95
  }
}

///|
/// Is pixel `(col, row)` of glyph `ch` lit?
///
/// * `col` must be in [0, glyph_width) = [0, 5); otherwise false.
/// * `row` must be in [0, glyph_height) = [0, 7); otherwise false.
/// * `ch` outside printable ASCII falls back to the tofu glyph, so
///   every in-bounds pixel of an unknown char returns true.
pub fn glyph_at(ch : Int, col : Int, row : Int) -> Bool {
  if col < 0 || col >= glyph_width { return false }
  if row < 0 || row >= glyph_height { return false }
  let idx = glyph_index(ch)
  let row_byte = glyph_table[idx * glyph_height + row]
  // Bit 4 = leftmost column, bit 0 = rightmost column.
  (((row_byte >> (glyph_width - 1 - col)) & 1) == 1)
}

///|
/// Measure a string in pixels: width = len * glyph_width,
/// height = glyph_height if non-empty else 0.
///
/// No inter-glyph kerning for now — fixed-pitch like the IBM PC.
pub fn measure_text(text : String) -> (Int, Int) {
  let n = text.length()
  if n == 0 { return (0, 0) }
  (n * glyph_width, glyph_height)
}
