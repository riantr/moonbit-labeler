// app_moui/bitmap_font.mbt — Phase 12 5x7 ASCII bitmap font.
//
// Hand-rolled from the classic IBM PC CGA / MDA ROM footprint.
// 95 printable ASCII glyphs (0x20..0x7E), each 7 rows x 5 cols,
// stored row-major: byte r of glyph g is the bit pattern of row r,
// with bits 4..0 (MSB-to-LSB) = pixels left-to-right.
//
// A 96th glyph — the "tofu" fallback (every pixel on, 0x1F * 7) —
// is appended so any out-of-range char renders as a filled 5x7 box
// instead of crashing. glyph_at() never panics on coord bounds:
// it returns false for (col, row) outside [0,5) x [0,7).
//
// Why no fontconfig / freetype / TrueType:
//   - Atlas size is 96 * 7 = 672 bytes. Trivial.
//   - Labeler UI text is short ASCII. No kerning / ligatures / Unicode.
//   - Zero external dependencies.
//
// IMPORTANT: the `glyph_table` array literal below is a flat
// 7-int-per-line layout with NO inline `// xxx` comments. MoonBit
// 0.1.x array parsing is sensitive to mid-literal comments and
// can silently truncate the array, leading to out-of-bounds at
// the first `glyph_table[idx*7+r]` lookup. Keep the body clean.

///|
/// Total glyph count = 95 ASCII + 1 tofu fallback.
pub let glyph_count : Int = 96

///|
/// Glyph cell width in pixels.
pub let glyph_width : Int = 5

///|
/// Glyph cell height in pixels.
pub let glyph_height : Int = 7

///|
/// Glyph bitmap table. Each entry is 7 rows; each row is a byte
/// with bits 4..0 (MSB->LSB) = leftmost..rightmost pixel.
///
/// Layout: glyph_table[i * 7 + r] = row r of glyph i, where
/// i = ch - 0x20 for printable ASCII, i = 95 for the tofu fallback.
///
/// Total entries: 96 * 7 = 672.
///
/// Declared BEFORE the API functions so the function bodies can
/// reference it; MoonBit 0.1.x requires top-level `let`s to be
/// declared before any function that uses them.
let glyph_table : Array[Int] = [
  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 
  0x02, 0x02, 0x02, 0x02, 0x00, 0x00, 0x02, 
