.DS_Store
_build/
target/
.mooncakes/
.moonagent/
.proton/
# Proton native prebuilts extracted for `proton_cli build` on Windows.
# The actual artifact lives in target/proton-dist/ after `proton_cli package`.
proton/
# CEF download log from `proton_cli cef setup` (151 MB tarball trace).
cef_setup.log
# Local build-driver script + scratch log; not part of the project.
build_with_msvc.bat
build.log
# QA helper scripts/reports (local pipeline, not source).
qa_test.bat
qa/
# One-off command output (debugging captures; not source).
check_output.txt
check_out.txt
publish_out.txt
frontend/dist/
frontend/node_modules/
# Sample / dataset images — user data, large, varies per deployment.
data/Image*/
data/Label*/
# But keep a tiny example so the format is documented.
!data/.gitkeep
# Eclipse / VS backups
*.evb
*.bak
# Leftover exe at root (the real portable build lives in target/proton-dist/)
/moonbit-labeler.exe
# Loose type-list files dropped at the repo root by mistake.
/types.txt
# Temporary CDP smoke-test scripts (debugging helpers, not source).
.tmp-*.mjs
.tmp-*
tmp_force_check/
# Debug log captures from PowerShell / bash sessions (format, git, etc.)
# — these are diagnostic dumps, not source.
*.log
fmt*.txt
gh*.txt
unit.txt
sast.txt
gh_chk.txt
push*_out.txt
check_out*.txt
publish_out.txt
# npm audit reports (transient, not source)
frontend/audit.json
# Trashed / moved-out files kept around for safety; clean up periodically.
tests/.trash/
# Empty stub directories from abandoned refactor attempts.
benchmarks/
# staging-moonbit-image/ is a separate package (riantr/moonbit_image
# workspace) tracked from its own dir if/when it gets a repo. For
# now it's a local-only staging area for the next mooncakes publish.
staging-moonbit-image/
# Disabled stub files from the stdio-mode-as-subpackage attempt.
# Exception: app/moon.pkg.disabled IS tracked (publish-workaround).
*.disabled
!app/moon.pkg.disabled
