// riantr/moonbit_labeler — the app's main entry point and bundle of
// shared library code. See README.mbt.md for the project layout.
//
// The actual implementation lives in:
//   * app/                  — Proton IPC shell (executable, requires proton)
//   * extensions/labeler/   — labeling backend (uses riantr/moonbit_image)
//   * extensions/counter/   — small counter example used by the app
//
// Image decode/encode comes from the shared `riantr/moonbit_image`
// package on mooncakes.io (pulled in via `moon.mod`). A prior
// vendored copy of `buildliming/moonbit_image` lived under
// `extensions/image/` and was removed in commit b6dd1b1 — it
// shared an ancestor with the riantr package but missed the
// JPEG chroma-stride fix that prevents the "花屏" vertical stripes
// on 4:2:0 / 4:2:2 subsampled files.

import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/ref",
  "riantr/moonbit_image",
  "riantr/moonbit_labeler/extensions/labeler",
}

supported_targets = "native"

options(
  "native-stub": [ "app/native_stub.c" ],
)
