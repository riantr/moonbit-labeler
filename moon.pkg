// riantr/moonbit_labeler — the app's main entry point and bundle of
// shared library code. See README.mbt.md for the project layout.
//
// The actual implementation lives in:
//   * app/                  — Proton IPC shell (executable, requires proton)
//   * extensions/labeler/   — labeling backend (uses riantr/moonbit_image)
//   * extensions/counter/   — small counter example used by the app
//
// (extensions/image/ used to be a vendored copy of buildliming/moonbit_image;
// it has been replaced by the shared `riantr/moonbit_image` package on
// mooncakes.io, which includes a critical JPEG chroma-stride fix that
// the vendored buildliming copy was missing — without it, mizchi-mode
// thumbnails and full-res decodes showed the classic "花屏" vertical
// stripes on every 4:2:0 / 4:2:2 subsampled JPEG. The vendored
// sources are kept in git history but no longer linked.)

import {
  "moonbitlang/core/ref",
  "riantr/moonbit_image",
  "riantr/moonbit_labeler/extensions/labeler",
}

supported_targets = "native"

options(
  "native-stub": [ "app/native_stub.c" ],
)
